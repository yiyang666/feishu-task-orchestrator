# 复制为 .env 并填写你自己的值。.env 不会进入版本库。
#
# 飞书机器人（lark-cli）配置档名：用 `lark-cli profile list` 查看
FTO_LARK_PROFILE=cli_xxxxxxxxxxxxxxxx
# lark-cli 可执行文件路径（默认在 PATH 中查找 lark-cli）
FTO_LARK_CLI_BIN=lark-cli
# openclaw CLI 路径（默认在 PATH 中查找 openclaw）
FTO_OPENCLAW_BIN=openclaw

# 需要纳入「定时任务健康」监控的 cron sourceId（逗号分隔，可留空）
FTO_AUTOMATION_SOURCE_IDS=
# 上述 sourceId 的展示名（JSON 对象，可留空）
FTO_AUTOMATION_LABELS_JSON={}

# 默认任务卡投递目标（私聊场景）：channel_key 与接收方 open_id
FTO_DM_CHANNEL_KEY=feishu:dm:ou_xxxxxxxxxxxxxxxx
FTO_DM_TARGET_ID=ou_xxxxxxxxxxxxxxxx

# 可选：轮询与超时
# FTO_POLL_INTERVAL_SECONDS=1
# FTO_SOFT_TIMEOUT_SECONDS=600
# FTO_HARD_TIMEOUT_SECONDS=7200
# FTO_DB_PATH=var/orchestrator.db
# FTO_SNAPSHOT_PATH=var/agent_status.json
# FTO_SESSION_PREFIXES=
